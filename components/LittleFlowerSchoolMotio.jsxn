import React from "react";
import { motion, useReducedMotion } from "motion/react";

/**
 * Little Flower School - Animated Hero & Navigation Component
 * Implemented from Figma Frame: Desktop & Mobile Home Screen
 * Supports 'prefers-reduced-motion' for accessibility.
 */

export default function LittleFlowerSchoolMotion({
  onEnquireClick = () => {},
  onCallClick = () => {},
  onWhatsAppClick = () => {},
}) {
  const shouldReduceMotion = useReducedMotion();

  // Animation variants
  const containerVariants = {
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: {
        staggerChildren: shouldReduceMotion ? 0 : 0.15,
        delayChildren: 0.1,
      },
    },
  };

  const itemFadeUp = {
    hidden: { opacity: 0, y: shouldReduceMotion ? 0 : 20 },
    visible: {
      opacity: 1,
      y: 0,
      transition: {
        duration: 0.5,
        ease: [0.16, 1, 0.3, 1],
      },
    },
  };

  const badgePulse = {
    scale: shouldReduceMotion ? 1 : [1, 1.05, 1],
    transition: {
      duration: 2,
      repeat: Infinity,
      ease: "easeInOut",
    },
  };

  return (
    <div className="lfs-app-wrapper" data-node-id="1:17" style={styles.page}>
      {/* 1. Top Utility Bar */}
      <motion.div
        initial={{ opacity: 0, y: -10 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.4 }}
        style={styles.topBar}
        data-node-id="1:18"
      >
        <div style={styles.topContent}>
          <div style={styles.topContact}>
            <span>📞 <strong>Mob:</strong> 091109 59937</span>
            <span>📍 Kutubpur Kothi, Hajipur, Bihar 844125</span>
            <span>🕒 Office: 8:00 AM – 2:00 PM</span>
          </div>
          <motion.div
            animate={badgePulse}
            style={styles.topBadge}
          >
            <span style={styles.pulseDot} />
            ADMISSIONS 2027–2028 OPEN
          </motion.div>
        </div>
      </motion.div>

      {/* 2. Main Navigation Bar */}
      <motion.header
        initial={{ opacity: 0, y: -15 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.5, delay: 0.1 }}
        style={styles.navBar}
        data-node-id="1:20"
      >
        <div style={styles.navContent}>
          <div style={styles.brand}>
            <motion.div
              whileHover={{ rotate: 10, scale: 1.05 }}
              transition={{ type: "spring", stiffness: 300 }}
              style={styles.logoWrap}
            >
              <img
                src="assets/images/logo.jpg"
                alt="Little Flower School Emblem"
                style={styles.logoImg}
              />
            </motion.div>
            <div style={styles.brandText}>
              <span style={styles.schoolTitle}>Little Flower School</span>
              <span style={styles.schoolSubtitle}>KUTUBPUR KOTHI, HAJIPUR</span>
            </div>
          </div>

          <nav style={styles.navLinks} data-node-id="1:22">
            {[
              { name: "Home", href: "index.html" },
              { name: "About Us", href: "about.html" },
              { name: "Academics", href: "academics.html" },
              { name: "Facilities", href: "facilities.html" },
              { name: "Admissions", href: "admissions.html" },
              { name: "Gallery", href: "gallery.html" },
              { name: "Notice Board", href: "notices.html" },
              { name: "Contact", href: "contact.html" }
            ].map((item, idx) => (
              <motion.a
                key={item.name}
                href={item.href}
                whileHover={{ color: "#0284c7", y: -2 }}
                transition={{ duration: 0.2 }}
                style={idx === 0 ? styles.activeLink : styles.navLink}
              >
                {item.name}
              </motion.a>
            ))}
          </nav>

          <motion.button
            whileHover={{ scale: 1.04, boxShadow: "0 6px 20px rgba(2, 132, 199, 0.4)" }}
            whileTap={{ scale: 0.96 }}
            onClick={onEnquireClick}
            style={styles.primaryBtn}
          >
            Enquire Now
          </motion.button>
        </div>
      </motion.header>

      {/* 3. Hero Section */}
      <section style={styles.heroSection}>
        <motion.div
          variants={containerVariants}
          initial="hidden"
          animate="visible"
          style={styles.heroGrid}
        >
          {/* Left Column: Hero Content */}
          <div style={styles.heroLeft}>
            <motion.div variants={itemFadeUp} style={styles.heroPill}>
              <span style={styles.pillTag}>ADMISSIONS OPEN</span>
              <span style={styles.pillText}>Session 2027–2028 • Nursery to Class VIII</span>
            </motion.div>

            <motion.div
              variants={itemFadeUp}
              style={styles.mottoTag}
              data-node-id="1:25"
            >
              ★ LEARNING TODAY FOR LEADING TOMORROW ★
            </motion.div>

            <motion.h1
              variants={itemFadeUp}
              style={styles.heroHeading}
              data-node-id="1:24"
            >
              Inspiring Young Minds in a{" "}
              <span style={styles.headingGradient}>Nurturing Environment</span>
            </motion.h1>

            <motion.p
              variants={itemFadeUp}
              style={styles.heroDescription}
              data-node-id="1:26"
            >
              Welcome to <strong>Little Flower School</strong>, Kutubpur Kothi, Hajipur. We offer a balanced blend of academic excellence, moral grounding, values, and co-curricular development to help your child blossom into a confident future leader.
            </motion.p>

            <motion.div variants={itemFadeUp} style={styles.heroActions}>
              <motion.button
                whileHover={{ scale: 1.03, boxShadow: "0 8px 24px rgba(2, 132, 199, 0.45)" }}
                whileTap={{ scale: 0.97 }}
                onClick={onEnquireClick}
                style={styles.applyBtn}
              >
                Apply for Admission 2027–2028
              </motion.button>

              <motion.a
                href="tel:09110959937"
                whileHover={{ scale: 1.03, backgroundColor: "#f1f5f9" }}
                whileTap={{ scale: 0.97 }}
                onClick={onCallClick}
                style={styles.callBtn}
              >
                📞 Call 091109 59937
              </motion.a>
            </motion.div>

            {/* Checkmark Features */}
            <motion.div variants={itemFadeUp} style={styles.featureRow}>
              <span>✔ Holistic Child Care</span>
              <span>✔ Safe Bus Transport</span>
              <span>✔ Eco-Friendly Campus</span>
            </motion.div>
          </div>

          {/* Right Column: Hero Visual Card */}
          <motion.div
            variants={itemFadeUp}
            whileHover={shouldReduceMotion ? {} : { y: -6 }}
            transition={{ duration: 0.3 }}
            style={styles.heroCard}
            data-node-id="1:23"
          >
            <div style={styles.imageWrap}>
              <img
                src="assets/images/hero-students.jpg"
                alt="Joyful Little Flower School Students"
                style={styles.heroImg}
              />
              <motion.div
                initial={{ opacity: 0, scale: 0.8 }}
                animate={{ opacity: 1, scale: 1 }}
                transition={{ delay: 0.5, duration: 0.4 }}
                style={styles.statBadge}
              >
                <div style={styles.statIcon}>★</div>
                <div>
                  <div style={styles.statNumber}>15:1</div>
                  <div style={styles.statLabel}>Student-Teacher Ratio</div>
                </div>
              </motion.div>
            </div>

            <div style={styles.cardFooter}>
              <div>
                <h4 style={styles.cardTitle}>Joyful & Disciplined Learning</h4>
                <p style={styles.cardSubtitle}>Little Flower School, Kutubpur Kothi, Hajipur</p>
              </div>
              <motion.a
                href="#gallery"
                whileHover={{ scale: 1.05 }}
                whileTap={{ scale: 0.95 }}
                style={styles.cardActionBtn}
              >
                View Photos
              </motion.a>
            </div>
          </motion.div>
        </motion.div>
      </section>

      {/* 4. Docked Mobile Bottom Bar */}
      <div style={styles.mobileDockedBar}>
        <motion.a
          href="tel:09110959937"
          whileTap={{ scale: 0.95 }}
          style={styles.dockedCallBtn}
        >
          📞 Call School
        </motion.a>
        <motion.a
          href="https://wa.me/919110959937"
          target="_blank"
          rel="noopener"
          whileTap={{ scale: 0.95 }}
          style={styles.dockedWaBtn}
        >
          💬 WhatsApp
        </motion.a>
      </div>
    </div>
  );
}

